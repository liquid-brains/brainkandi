{
  "expo": {
    "name": "Brain Kandi",
    "slug": "brainkandi",
    "version": "0.1.0",
    "orientation": "portrait",
    "jsEngine": "jsc",
    "userInterfaceStyle": "dark",
    "icon": "./logo/icon-input.png",
    "splash": {
      "image": "./logo/brainkandi.png",
      "resizeMode": "contain",
      "backgroundColor": "#ff1493"
    },
    "plugins": [
      "expo-notifications",
      "./plugins/with-android-cleartext.js"
    ],
    "android": {
      "package": "org.brainkandi.app",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./logo/icon-input.png",
        "backgroundColor": "#ff1493"
      }
    },
    "ios": {
      "bundleIdentifier": "org.brainkandi.app"
    }
  }
}
